# Server Port
PORT=3000

# JWT Secret
JWT_SECRET=super-secret-restaurant-os-key-2026

# Database Provider Configuration (Supabase PostgreSQL or Local SQLite)
# For Supabase Cloud PostgreSQL, set provider in schema.prisma to postgresql and use:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth, Storage & Realtime Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
